      "packages": [
        "程序补丁包 1.0.1"
      ]
    },
    {
      "version": "1.0.2",
      "packages": [
        "动画补丁包 1.0.2"
      ]
    },
    {
      "version": "1.0.3",
      "packages": [
        "程序补丁包 1.0.3",
        "动画补丁包 1.0.3"
      ]
    }
  ],
  "assetNaming": "用户可见名称使用补丁类型和公开版本；底层文件名保持客户端兼容，内容 ID 仅用于素材校验。"
