  "carry": "公开版本延续上一稳定版；版本第三段满10进一位到第二段，第二段满10进一位到第一段，归零段位。例如 0.9.9 → 1.0.0。",
  "examples": [
    "0.9.8 → 0.9.9",
    "0.9.9 → 1.0.0",
    "1.0.9 → 1.1.0",
    "1.9.9 → 2.0.0"
  ],
  "legacyVersionsPreserved": true,
  "helper": "release_version.py",
  "publicPatchRule": "程序补丁与动画补丁共用 GitHub 公开发布序列；单独发布推进一位，同时发布共用同一版本。",
  "patchDisplayNames": {
    "program": "程序补丁包 {version}",
    "animation": "动画补丁包 {version}"
  },
  "publicPatchExamples": [
    {
